//
// MTP's 2560-wide raw Q4_K rows: ten 144-byte blocks per vocabulary row.
// Same packed scale/minimum and nibble layout as qwen_owned/token_embedding_q4k,
// without its fixed 2048 width, trusted-ID assumptions, or noalias requirement.
// Host ID validation precedes every dispatch; device guards also prevent OOB.

amdgpu.target<gfx11-generic> @ggml_token_embedding_q4_wave32 {subgroup_size = 32}

kernel.def target(@ggml_token_embedding_q4_wave32) export("ggml_token_embedding_q4_k_f32") @ggml_token_embedding_q4_k_f32(%hidden_size: index, %vocabulary_count: index, %token_count: index) {
  %one = index.constant 1 : index
  %blocks = index.constant 10 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%blocks, %token_count, %one) workgroup_size(%threads, %one, %one) : index
} launch(%hidden_size: index, %vocabulary_count: index, %token_count: index, %weight: buffer, %ids: buffer, %output: buffer) {
  %width = index.constant 2560 : index
  %vocabulary = index.assume %vocabulary_count [range(%vocabulary_count, 1, 262144)] : index
  %tokens = index.assume %token_count [range(%token_count, 1, 8)] : index
  %block0 = kernel.workgroup.id<x> : index
  %block = index.assume %block0 [range(%block0, 0, 9)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %tokens)] : index
  %lane = kernel.workitem.id<x> : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %zero_offset = index.constant 0 : offset
  %row_bytes = index.constant 1440 : offset
  %block_bytes = index.constant 144 : offset
  %scale_offset = index.constant 4 : offset
  %code_offset = index.constant 16 : offset
  %iv = buffer.view %ids[%zero_offset] : buffer -> view<[%tokens]xi32>
  %id32 = view.load %iv[%token] : view<[%tokens]xi32> -> i32
  %zero32 = scalar.constant 0 : i32
  %limit32 = index.cast %vocabulary : index to i32
  %nonnegative = scalar.cmpi sge, %id32, %zero32 : i32
  %below_limit = scalar.cmpi slt, %id32, %limit32 : i32
  %valid = scalar.andi %nonnegative, %below_limit : i1
  scf.if %valid {
    %id0 = index.cast %id32 : i32 to index
    %id = index.assume %id0 [range(%id0, 0, 262143), lt(%id0, %vocabulary)] : index
    %row_base = index.scale %id, %row_bytes : index, offset -> offset
    %block_add = index.scale %block, %block_bytes : index, offset -> offset
    %block_base = index.add %row_base, %block_add : offset
    %scale_base = index.add %block_base, %scale_offset : offset
    %code_base = index.add %block_base, %code_offset : offset
    %dmv = buffer.view %weight[%block_base] : buffer -> view<2xf16>
    %sv = buffer.view %weight[%scale_base] : buffer -> view<12xi8>
    %qv = buffer.view %weight[%code_base] : buffer -> view<128xi8>
    %d16 = view.load %dmv[0] : view<2xf16> -> f16
    %min16 = view.load %dmv[1] : view<2xf16> -> f16
    %d = scalar.extf %d16 : f16 to f32
    %dmin = scalar.extf %min16 : f16 to f32
    %group = index.div %lane, %c32 : index
    %within = index.rem %lane, %c32 : index
    %scale_lane = index.rem %group, %c4 : index
    %min_lane = index.add %scale_lane, %c4 : index
    %high_lane = index.add %min_lane, %c4 : index
    %s0b = view.load %sv[%scale_lane] : view<12xi8> -> i8
    %s1b = view.load %sv[%min_lane] : view<12xi8> -> i8
    %s2b = view.load %sv[%high_lane] : view<12xi8> -> i8
    %s0 = scalar.extui %s0b : i8 to i32
    %s1 = scalar.extui %s1b : i8 to i32
    %s2 = scalar.extui %s2b : i8 to i32
    %mask15 = scalar.constant 15 : i32
    %mask63 = scalar.constant 63 : i32
    %shift4 = scalar.constant 4 : i32
    %shift6 = scalar.constant 6 : i32
    %slow = scalar.andi %s0, %mask63 : i32
    %mlow = scalar.andi %s1, %mask63 : i32
    %supper0 = scalar.shrui %s0, %shift6 : i32
    %mupper0 = scalar.shrui %s1, %shift6 : i32
    %supper = scalar.shli %supper0, %shift4 : i32
    %mupper = scalar.shli %mupper0, %shift4 : i32
    %sbottom = scalar.andi %s2, %mask15 : i32
    %mbottom = scalar.shrui %s2, %shift4 : i32
    %shigh = scalar.ori %sbottom, %supper : i32
    %mhigh = scalar.ori %mbottom, %mupper : i32
    %low_group = index.cmp ult, %group, %c4 : index
    %scale32 = scf.select %low_group, %slow, %shigh : i32
    %min32 = scf.select %low_group, %mlow, %mhigh : i32
    %scale = scalar.uitofp %scale32 : i32 to f32
    %minimum = scalar.uitofp %min32 : i32 to f32
    %page = index.div %group, %c2 : index
    %page_base = index.mul %page, %c32 : index
    %code_index = index.add %page_base, %within : index
    %qb = view.load %qv[%code_index] : view<128xi8> -> i8
    %q32 = scalar.extui %qb : i8 to i32
    %half = index.rem %group, %c2 : index
    %shift_index = index.mul %half, %c4 : index
    %shift = index.cast %shift_index : index to i32
    %qshifted = scalar.shrui %q32, %shift : i32
    %qmasked = scalar.andi %qshifted, %mask15 : i32
    %q = scalar.uitofp %qmasked : i32 to f32
    %dscale = scalar.mulf %d, %scale : f32
    %mscale = scalar.mulf %dmin, %minimum : f32
    %product = scalar.mulf %dscale, %q : f32
    %value = scalar.subf %product, %mscale : f32
    %extent = index.mul %tokens, %width : index
    %ov = buffer.view %output[%zero_offset] : buffer -> view<[%extent]xf32>
    %row_output = index.mul %token, %width : index
    %block_output = index.mul %block, %c256 : index
    %column = index.add %block_output, %lane : index
    %position = index.add %row_output, %column : index
    view.store %value, %ov[%position] : f32, view<[%extent]xf32>
  }
  kernel.return
}
