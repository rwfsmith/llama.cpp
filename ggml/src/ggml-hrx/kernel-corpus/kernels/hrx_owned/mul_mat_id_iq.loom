//
// Raw GGML IQ3_XXS (98 bytes/256) and IQ4_XS (136 bytes/256).
// LUT buffer: iq3xxs_grid bytes [1024], ksigns_iq2xs [128], kvalues_iq4nl [16].
// One wave owns one output channel/route/token. T=1..8, shared F32 input per token.
// Contract: every route ID is in [0, expert_count). The pinned AMDGPU backend
// cannot lower kernel.assert. Invalid IDs write quiet NaN without loading weights:
// an explicit non-finite error result, not a successful projection or a GPU trap.

amdgpu.target<gfx11-generic> @ggml_iq_expert_wave64 {subgroup_size = 64}

func.def inline @ggml_iq3_xxs_element(%weight: buffer, %base: offset, %element: index, %tables: buffer) -> (f32) {
  %zero = index.constant 0 : offset
  %two = index.constant 2 : offset
  %sign_offset = index.constant 1024 : offset
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c1i = scalar.constant 1 : i32
  %c7i = scalar.constant 7 : i32
  %c8i = scalar.constant 8 : i32
  %c16i = scalar.constant 16 : i32
  %c24i = scalar.constant 24 : i32
  %c28i = scalar.constant 28 : i32
  %c127i = scalar.constant 127 : i32
  %c0i = scalar.constant 0 : i32
  %half = scalar.constant 0.5 : f32
  %one = scalar.constant 1.0 : f32
  %minus_one = scalar.constant -1.0 : f32
  %dview = buffer.view %weight[%base] : buffer -> view<1xf16>
  %qbase = index.add %base, %two : offset
  %qs = buffer.view %weight[%qbase] : buffer -> view<96xi8>
  %grid = buffer.view %tables[%zero] : buffer -> view<256x4xi8>
  %signs = buffer.view %tables[%sign_offset] : buffer -> view<128xi8>
  %j = index.assume %element [range(%element, 0, 255)] : index
  %group = index.div %j, %c32 : index
  %group4 = index.mul %group, %c4 : index
  %s0 = index.add %group4, %c64 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %s1 = index.add %s0, %c1 : index
  %s2 = index.add %s0, %c2 : index
  %s3 = index.add %s0, %c3 : index
  // The sign word starts at byte 66, so use byte loads rather than an unaligned u32.
  %b0 = view.load %qs[%s0] : view<96xi8> -> i8
  %b1 = view.load %qs[%s1] : view<96xi8> -> i8
  %b2 = view.load %qs[%s2] : view<96xi8> -> i8
  %b3 = view.load %qs[%s3] : view<96xi8> -> i8
  %u0 = scalar.extui %b0 : i8 to i32
  %u1 = scalar.extui %b1 : i8 to i32
  %u2 = scalar.extui %b2 : i8 to i32
  %u3 = scalar.extui %b3 : i8 to i32
  %v1 = scalar.shli %u1, %c8i : i32
  %v2 = scalar.shli %u2, %c16i : i32
  %v3 = scalar.shli %u3, %c24i : i32
  %w01 = scalar.ori %u0, %v1 : i32
  %w23 = scalar.ori %v2, %v3 : i32
  %word = scalar.ori %w01, %w23 : i32
  %scale_i = scalar.shrui %word, %c28i : i32
  %scale_f = scalar.uitofp %scale_i : i32 to f32
  %scale_plus = scalar.addf %scale_f, %half : f32
  %d16 = view.load %dview[0] : view<1xf16> -> f16
  %d = scalar.extf %d16 : f16 to f32
  %dscale = scalar.mulf %d, %scale_plus : f32
  %db = scalar.mulf %dscale, %half : f32
  %in_group = index.rem %j, %c32 : index
  %octet = index.div %in_group, %c8 : index
  %octet_i = index.cast %octet : index to i32
  %shift = scalar.muli %octet_i, %c7i : i32
  %sign_raw = scalar.shrui %word, %shift : i32
  %sign_idx_i = scalar.andi %sign_raw, %c127i : i32
  %sign_idx0 = index.cast %sign_idx_i : i32 to index
  %sign_idx = index.assume %sign_idx0 [range(%sign_idx0, 0, 127)] : index
  %sign_byte = view.load %signs[%sign_idx] : view<128xi8> -> i8
  %sign_word = scalar.extui %sign_byte : i8 to i32
  %bit = index.rem %j, %c8 : index
  %bit_i = index.cast %bit : index to i32
  %mask = scalar.shli %c1i, %bit_i : i32
  %sign_bit = scalar.andi %sign_word, %mask : i32
  %negative = scalar.cmpi ne, %sign_bit, %c0i : i32
  %sign = scf.select %negative, %minus_one, %one : f32
  %code_pos = index.div %j, %c4 : index
  %code_byte = view.load %qs[%code_pos] : view<96xi8> -> i8
  %code_i = scalar.extui %code_byte : i8 to i32
  %code0 = index.cast %code_i : i32 to index
  %code = index.assume %code0 [range(%code0, 0, 255)] : index
  %grid_col = index.rem %j, %c4 : index
  %grid_byte = view.load %grid[%code, %grid_col] : view<256x4xi8> -> i8
  %grid_i = scalar.extui %grid_byte : i8 to i32
  %grid_f = scalar.uitofp %grid_i : i32 to f32
  %magnitude = scalar.mulf %db, %grid_f : f32
  %result = scalar.mulf %magnitude, %sign : f32
  func.return %result : f32
}

func.def inline @ggml_iq4_xs_element(%weight: buffer, %base: offset, %element: index, %tables: buffer) -> (f32) {
  %two = index.constant 2 : offset
  %four = index.constant 4 : offset
  %eight = index.constant 8 : offset
  %lut_offset = index.constant 1152 : offset
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c2i = scalar.constant 2 : i32
  %c4i = scalar.constant 4 : i32
  %c3i = scalar.constant 3 : i32
  %c15i = scalar.constant 15 : i32
  %c32i = scalar.constant 32 : i32
  %dview = buffer.view %weight[%base] : buffer -> view<1xf16>
  %hi_base = index.add %base, %two : offset
  %lo_base = index.add %base, %four : offset
  %qs_base = index.add %base, %eight : offset
  %hi_view = buffer.view %weight[%hi_base] : buffer -> view<1xi16>
  %lo_view = buffer.view %weight[%lo_base] : buffer -> view<4xi8>
  %qs = buffer.view %weight[%qs_base] : buffer -> view<128xi8>
  %lut = buffer.view %tables[%lut_offset] : buffer -> view<16xi8>
  %j = index.assume %element [range(%element, 0, 255)] : index
  %group = index.div %j, %c32 : index
  %group_i = index.cast %group : index to i32
  %lo_idx = index.div %group, %c2 : index
  %lo_half = index.rem %group, %c2 : index
  %lo_shift_idx = index.mul %lo_half, %c4 : index
  %lo_shift = index.cast %lo_shift_idx : index to i32
  %lo_byte = view.load %lo_view[%lo_idx] : view<4xi8> -> i8
  %lo_word = scalar.extui %lo_byte : i8 to i32
  %lo_shifted = scalar.shrui %lo_word, %lo_shift : i32
  %lo = scalar.andi %lo_shifted, %c15i : i32
  %hi16 = view.load %hi_view[0] : view<1xi16> -> i16
  %hi_word = scalar.extui %hi16 : i16 to i32
  %hi_shift = scalar.muli %group_i, %c2i : i32
  %hi_shifted = scalar.shrui %hi_word, %hi_shift : i32
  %hi_two = scalar.andi %hi_shifted, %c3i : i32
  %hi = scalar.shli %hi_two, %c4i : i32
  %scale_raw = scalar.ori %lo, %hi : i32
  %scale_i = scalar.subi %scale_raw, %c32i : i32
  %scale_f = scalar.sitofp %scale_i : i32 to f32
  %d16 = view.load %dview[0] : view<1xf16> -> f16
  %d = scalar.extf %d16 : f16 to f32
  %dl = scalar.mulf %d, %scale_f : f32
  %within = index.rem %j, %c32 : index
  %nibble = index.div %within, %c16 : index
  %nibble_shift_idx = index.mul %nibble, %c4 : index
  %nibble_shift = index.cast %nibble_shift_idx : index to i32
  %byte_in_group = index.rem %within, %c16 : index
  %group_base = index.mul %group, %c16 : index
  %byte_idx = index.add %group_base, %byte_in_group : index
  %packed = view.load %qs[%byte_idx] : view<128xi8> -> i8
  %packed_i = scalar.extui %packed : i8 to i32
  %code_shifted = scalar.shrui %packed_i, %nibble_shift : i32
  %code_i = scalar.andi %code_shifted, %c15i : i32
  %code0 = index.cast %code_i : i32 to index
  %code = index.assume %code0 [range(%code0, 0, 15)] : index
  %value8 = view.load %lut[%code] : view<16xi8> -> i8
  %value_i = scalar.extsi %value8 : i8 to i32
  %value_f = scalar.sitofp %value_i : i32 to f32
  %result = scalar.mulf %dl, %value_f : f32
  func.return %result : f32
}

func.def inline @ggml_iq_expert_dot(%input_size: index, %output_size: index, %expert_count: index, %route_count: index, %token_count: index, %route_id_stride: index, %weight: buffer, %input: buffer, %ids: buffer, %tables: buffer, %output: buffer, %iq3: i1, %block_bytes: offset) {
  %width = index.assume %input_size [range(%input_size, 256, 2560), mul(%input_size, 256)] : index
  %outputs = index.assume %output_size [range(%output_size, 1, 640)] : index
  %experts = index.assume %expert_count [range(%expert_count, 1, 512)] : index
  %routes = index.assume %route_count [range(%route_count, 1, 16)] : index
  %tokens = index.assume %token_count [range(%token_count, 1, 8)] : index
  %stride = index.assume %route_id_stride [range(%route_id_stride, 10, 512)] : index
  %token0 = kernel.workgroup.id<z> : index
  %token, %ntokens = index.assume %token0, %tokens [lt(%token0, %tokens)] : index, index
  %row0 = kernel.workgroup.id<x> : index
  %route0 = kernel.workgroup.id<y> : index
  %row, %nrows = index.assume %row0, %outputs [lt(%row0, %outputs)] : index, index
  %route, %nroutes = index.assume %route0, %routes [lt(%route0, %routes)] : index, index
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : offset
  %zero_idx = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %zero_f = scalar.constant 0.0 : f32
  %qnan_bits = scalar.constant 2143289344 : i32
  %four = index.constant 4 : offset
  %id_row = index.mul %token, %stride : index
  %id_base = index.scale %id_row, %four : index, offset -> offset
  %ids_view = buffer.view %ids[%id_base] : buffer -> view<[%nroutes]xi32>
  %x = buffer.view %input[%zero] : buffer -> view<[%ntokens]x[%width]xf32>
  %y = buffer.view %output[%zero] : buffer -> view<[%ntokens]x[%nroutes]x[%nrows]xi32>
  %expert_i = view.load %ids_view[%route] : view<[%nroutes]xi32> -> i32
  %expert0 = index.cast %expert_i : i32 to index
  // Invalid IDs must never address weights; see the unsupported-assert contract above.
  %valid = index.cmp ult, %expert0, %experts : index
  %sum = scf.if %valid -> (f32) {
    %expert, %nexperts = index.assume %expert0, %experts [range(%expert0, 0, 511), lt(%expert0, %experts)] : index, index
    %blocks = index.div %width, %c256 : index
    %expert_rows = index.mul %expert, %nrows : index
    %flat_row = index.add %expert_rows, %row : index
    %row_blocks = index.mul %flat_row, %blocks : index
    %row_bytes = index.scale %row_blocks, %block_bytes : index, offset -> offset
    %partial = scf.for %column = [%lane to %width step %c64](%acc = %zero_f : f32) -> (f32) {
      %col = index.assume %column [lt(%column, %width)] : index
      %block = index.div %col, %c256 : index
      %element = index.rem %col, %c256 : index
      %block_offset = index.scale %block, %block_bytes : index, offset -> offset
      %base = index.add %row_bytes, %block_offset : offset
      %w = scf.if %iq3 -> (f32) {
        %v3 = func.call @ggml_iq3_xxs_element(%weight, %base, %element, %tables) : (buffer, offset, index, buffer) -> (f32)
        scf.yield %v3 : f32
      } else {
        %v4 = func.call @ggml_iq4_xs_element(%weight, %base, %element, %tables) : (buffer, offset, index, buffer) -> (f32)
        scf.yield %v4 : f32
      }
      %activation = view.load %x[%token, %col] : view<[%ntokens]x[%width]xf32> -> f32
      %product = scalar.mulf %w, %activation : f32
      %next = scalar.addf %acc, %product : f32
      scf.yield %next : f32
    }
    scf.yield %partial : f32
  } else {
    scf.yield %zero_f : f32
  }
  %total = kernel.workgroup.reduce<addf> %sum : f32
  %writer = index.cmp eq, %lane, %zero_idx : index
  scf.if %writer {
    // Store invalid results as bits, outside floating-point reduction/NaN handling.
    %result = scf.if %valid -> (i32) {
      %bits = scalar.bitcast %total : f32 to i32
      scf.yield %bits : i32
    } else {
      scf.yield %qnan_bits : i32
    }
    view.store %result, %y[%token, %route, %row] : i32, view<[%ntokens]x[%nroutes]x[%nrows]xi32>
  }
  func.return
}

kernel.def target(@ggml_iq_expert_wave64) export("ggml_mul_mat_id_iq3_xxs_f32") @ggml_mul_mat_id_iq3_xxs_f32(%input_size: index, %output_size: index, %expert_count: index, %route_count: index, %token_count: index, %route_id_stride: index) {
  %one = index.constant 1 : index
  %wave = index.constant 64 : index
  kernel.launch.config workgroups(%output_size, %route_count, %token_count) workgroup_size(%wave, %one, %one) : index
} launch(%input_size: index, %output_size: index, %expert_count: index, %route_count: index, %token_count: index, %route_id_stride: index, %weight: buffer, %input: buffer, %ids: buffer, %tables: buffer, %output: buffer) {
  %iq3 = scalar.constant true : i1
  %bytes = index.constant 98 : offset
  func.call @ggml_iq_expert_dot(%input_size, %output_size, %expert_count, %route_count, %token_count, %route_id_stride, %weight, %input, %ids, %tables, %output, %iq3, %bytes) : (index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer, i1, offset)
  kernel.return
}

kernel.def target(@ggml_iq_expert_wave64) export("ggml_mul_mat_id_iq4_xs_f32") @ggml_mul_mat_id_iq4_xs_f32(%input_size: index, %output_size: index, %expert_count: index, %route_count: index, %token_count: index, %route_id_stride: index) {
  %one = index.constant 1 : index
  %wave = index.constant 64 : index
  kernel.launch.config workgroups(%output_size, %route_count, %token_count) workgroup_size(%wave, %one, %one) : index
} launch(%input_size: index, %output_size: index, %expert_count: index, %route_count: index, %token_count: index, %route_id_stride: index, %weight: buffer, %input: buffer, %ids: buffer, %tables: buffer, %output: buffer) {
  %iq3 = scalar.constant false : i1
  %bytes = index.constant 136 : offset
  func.call @ggml_iq_expert_dot(%input_size, %output_size, %expert_count, %route_count, %token_count, %route_id_stride, %weight, %input, %ids, %tables, %output, %iq3, %bytes) : (index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer, i1, offset)
  kernel.return
}
