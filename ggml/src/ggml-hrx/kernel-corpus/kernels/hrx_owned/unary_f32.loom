//
// Generic elementwise f32 activations (GGML_OP_UNARY).
//
// These exist so an activation stops being a backend boundary. A single
// SIGMOID or SOFTPLUS node that only the CPU can run forces ggml_backend_sched
// to close the current HRX split, stage its inputs back to host memory, run one
// scalar op, and re-enter the GPU -- and qwen4exp's decode graph has 496 of them
// (326 SIGMOID, 134 SILU, 36 SOFTPLUS). Each is arithmetically trivial; the cost
// is entirely in the split it creates.
//
// Every kernel here is a flat, tightly packed f32 -> f32 map over
// %element_count elements, which is what dispatch-unary.cpp guarantees by
// requiring both operands to be contiguous and same-shaped. The 256-wide
// workgroup and rounding-up launch geometry mirror hrx_owned/add_f32.loom.

amdgpu.target<gfx11-generic> @ggml_unary_gfx11_wave64 {subgroup_size = 64}

kernel.def target(@ggml_unary_gfx11_wave64) export("ggml_sigmoid_f32") @ggml_sigmoid_f32(%element_count: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %twofiftysix : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%element_count: index, %input: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 134217728)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %twofiftysix = index.constant 256 : index
  %base0 = index.mul %workgroup, %twofiftysix : index
  %linear0 = index.add %base0, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 134217983)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %zero_offset = index.constant 0 : offset
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %value = view.load %input_view[%linear] : view<[%count]xf32> -> f32
    // ggml op_sigmoid: 1/(1 + expf(-x)).
    %result = scalar.logisticf<afn> %value : f32
    view.store %result, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}

kernel.def target(@ggml_unary_gfx11_wave64) export("ggml_silu_f32") @ggml_silu_f32(%element_count: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %twofiftysix : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%element_count: index, %input: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 134217728)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %twofiftysix = index.constant 256 : index
  %base0 = index.mul %workgroup, %twofiftysix : index
  %linear0 = index.add %base0, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 134217983)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %zero_offset = index.constant 0 : offset
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %value = view.load %input_view[%linear] : view<[%count]xf32> -> f32
    // ggml op_silu: x/(1 + expf(-x)). Same intrinsic the routed-FFN kernels use.
    %result = scalar.siluf %value : f32
    view.store %result, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}

kernel.def target(@ggml_unary_gfx11_wave64) export("ggml_relu_f32") @ggml_relu_f32(%element_count: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %twofiftysix : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%element_count: index, %input: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 134217728)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %twofiftysix = index.constant 256 : index
  %base0 = index.mul %workgroup, %twofiftysix : index
  %linear0 = index.add %base0, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 134217983)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %zero_offset = index.constant 0 : offset
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %value = view.load %input_view[%linear] : view<[%count]xf32> -> f32
    // ggml op_relu: (x > 0) ? x : 0. maxnumf returns the non-NaN operand for a
    // NaN input, which matches ggml only for the non-NaN case; qwen4exp's RELU
    // is the MoE router's post-projection activation and never sees NaN.
    %zero = scalar.constant 0.0 : f32
    %result = scalar.maxnumf %value, %zero : f32
    view.store %result, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}

kernel.def target(@ggml_unary_gfx11_wave64) export("ggml_softplus_f32") @ggml_softplus_f32(%element_count: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %twofiftysix : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%element_count: index, %input: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 134217728)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %twofiftysix = index.constant 256 : index
  %base0 = index.mul %workgroup, %twofiftysix : index
  %linear0 = index.add %base0, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 134217983)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %zero_offset = index.constant 0 : offset
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %value = view.load %input_view[%linear] : view<[%count]xf32> -> f32
    // ggml op_softplus: (x > 20) ? x : logf(1 + expf(x)). The x > 20 arm is not
    // an optimization -- expf(x) overflows to +inf around x == 88, and qwen4exp
    // feeds this the raw ssm_dt projection, which is unbounded. Both arms are
    // evaluated and selected because expf(+inf) is finite-safe here (the select
    // discards it) and a branch would serialize the wave.
    %twenty = scalar.constant 20.0 : f32
    %saturated = scalar.cmpf ogt, %value, %twenty : f32
    %exponential = scalar.expf<afn> %value : f32
    %unit = scalar.constant 1.0 : f32
    %shifted = scalar.addf %exponential, %unit : f32
    %logarithm = scalar.logf<afn> %shifted : f32
    %result = scf.select %saturated, %value, %logarithm : f32
    view.store %result, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}

check.case public @ggml_sigmoid_f32_known_case {
  %four = check.literal value(4) : index
  %input = check.generate.fill value(0.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  // sigmoid(0) == 0.5 exactly.
  %expected = check.generate.fill value(0.5) : tensor<4xf32>
  func.call @ggml_sigmoid_f32(%four, %input, %output) : (index, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<4xf32>
  check.return
}

check.case public @ggml_silu_f32_known_case {
  %four = check.literal value(4) : index
  %input = check.generate.fill value(0.0) : tensor<4xf32>
  %output = check.generate.fill value(1.0) : tensor<4xf32>
  // silu(0) == 0*sigmoid(0) == 0 exactly. Seeding output with 1.0 proves the
  // kernel actually stores rather than leaving the destination untouched.
  %expected = check.generate.fill value(0.0) : tensor<4xf32>
  func.call @ggml_silu_f32(%four, %input, %output) : (index, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<4xf32>
  check.return
}

check.case public @ggml_relu_f32_negative_case {
  %four = check.literal value(4) : index
  %input = check.generate.fill value(-2.0) : tensor<4xf32>
  // Seeding the destination with a nonzero value proves the kernel stores the
  // clamp rather than leaving the buffer untouched.
  %output = check.generate.fill value(9.0) : tensor<4xf32>
  %expected = check.generate.fill value(0.0) : tensor<4xf32>
  func.call @ggml_relu_f32(%four, %input, %output) : (index, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.case public @ggml_relu_f32_positive_case {
  %four = check.literal value(4) : index
  %input = check.generate.iota offset(1) step(1) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.iota offset(1) step(1) : tensor<4xf32>
  func.call @ggml_relu_f32(%four, %input, %output) : (index, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.case public @ggml_softplus_f32_known_case {
  %four = check.literal value(4) : index
  %input = check.generate.fill value(0.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  // softplus(0) == log(2) == 0.6931471805599453.
  %expected = check.generate.fill value(0.6931471805599453) : tensor<4xf32>
  func.call @ggml_softplus_f32(%four, %input, %output) : (index, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<4xf32>
  check.return
}

check.case public @ggml_softplus_f32_saturated_case {
  %four = check.literal value(4) : index
  // 100 is well past both the x > 20 shortcut and the x ~ 88 expf overflow, so
  // this fails loudly (inf) if the select arm is ever dropped.
  %input = check.generate.fill value(100.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.fill value(100.0) : tensor<4xf32>
  func.call @ggml_softplus_f32(%four, %input, %output) : (index, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.benchmark<@ggml_sigmoid_f32_known_case> @ggml_sigmoid_f32_small
check.benchmark<@ggml_silu_f32_known_case> @ggml_silu_f32_small
check.benchmark<@ggml_relu_f32_positive_case> @ggml_relu_f32_small
check.benchmark<@ggml_softplus_f32_known_case> @ggml_softplus_f32_small
