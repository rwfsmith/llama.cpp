// SPDX-License-Identifier: Apache-2.0
//
// Broadcast copy for GGML_OP_REPEAT.
//
// qwen4exp materialises three of these per hyper-connected block --
// build_hc_combine() widens the block output back across the hc residual
// streams, build_ple() does the same for its value stream, and the block input
// is widened on the way in -- all of the form [n_embd, 1, T] -> [n_embd, hc, T].
// A decode census counts 98 REPEAT nodes, every one of them on the CPU, and 96
// of those sit as a lone single-node CPU split wedged between two HRX runs. A
// lone node is the worst possible placement: it costs two split boundaries to
// run one op, and at ~1.85 ms per boundary those 96 nodes were the single
// largest remaining source of scheduling overhead in the graph.
//
// The general ggml repeat can tile along any axis. This kernel implements the
// case that actually appears: src is 1 on one middle axis and agrees with dst
// everywhere else, so dst[outer][mid][i] = src[outer][i]. Addressing is 2D on
// both sides -- [outer]x[period] over src, [outer*mid]x[period] over dst -- so
// every index is bounded by a value the launch geometry proves. A flat index
// cannot be shown in range against a dynamic extent; this is the construction
// hrx_owned/gather_add_f32.loom and hrx_owned/mul_f32.loom use.
//
// dispatch-elementwise.cpp is what proves the shape has this form and computes
// the three extents; anything else it declines and leaves on the CPU.

amdgpu.target<gfx11-generic> @ggml_repeat_gfx11_wave64 {subgroup_size = 64}

kernel.def target(@ggml_repeat_gfx11_wave64) export("ggml_repeat_f32") @ggml_repeat_f32(
    %period: index, %mid_count: index, %outer_count: index) {
  %one = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %period, %rounding : index
  %column_workgroup_count = index.div %rounded, %workgroup_size : index
  kernel.launch.config workgroups(%column_workgroup_count, %mid_count, %outer_count) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%period: index, %mid_count: index, %outer_count: index, %input: buffer, %output: buffer) {
  %width = index.assume %period [range(%period, 1, 1048576)] : index
  %mids = index.assume %mid_count [range(%mid_count, 1, 65536)] : index
  %outers = index.assume %outer_count [range(%outer_count, 1, 65536)] : index
  %column_workgroup = kernel.workgroup.id<x> : index
  %mid0 = kernel.workgroup.id<y> : index
  %outer0 = kernel.workgroup.id<z> : index
  %workitem = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 256 : index
  %mid, %launch_mids = index.assume %mid0, %mids [lt(%mid0, %mids)] : index, index
  %outer, %launch_outers = index.assume %outer0, %outers [lt(%outer0, %outers)] : index, index
  %destination_rows0 = index.mul %launch_outers, %launch_mids : index
  %destination_rows = index.assume %destination_rows0 [range(%destination_rows0, 1, 1048576)] : index
  %row_base = index.mul %outer, %launch_mids : index
  %row0 = index.add %row_base, %mid : index
  %row = index.assume %row0 [lt(%row0, %destination_rows)] : index
  %base0 = index.mul %column_workgroup, %workgroup_size : index
  %column0 = index.add %base0, %workitem : index
  %column = index.assume %column0 [range(%column0, 0, 1048575)] : index
  %in_bounds = index.cmp ult, %column, %width : index
  %zero_offset = index.constant 0 : offset
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%launch_outers]x[%width]xf32>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%destination_rows]x[%width]xf32>
  scf.if %in_bounds {
    %safe_column = index.assume %column [lt(%column, %width)] : index
    %value = view.load %input_view[%outer, %safe_column] : view<[%launch_outers]x[%width]xf32> -> f32
    view.store %value, %output_view[%row, %safe_column] : f32, view<[%destination_rows]x[%width]xf32>
  }
  kernel.return
}

// The shape qwen4exp actually emits, reduced to a uniform source row: a single
// source row tiled across the hyper-connection streams. Pins that every
// destination row is written, including the ones past the first tile.
check.case public @ggml_repeat_f32_stream_tile_case {
  %period = check.literal value(4) : index
  %mid_count = check.literal value(3) : index
  %outer_count = check.literal value(1) : index
  %input = check.generate.fill value(7.0) : tensor<1x4xf32>
  %output = check.generate.fill value(0.0) : tensor<3x4xf32>
  %expected = check.generate.fill value(7.0) : tensor<3x4xf32>
  func.call @ggml_repeat_f32(%period, %mid_count, %outer_count, %input, %output) : (index, index, index, tensor<1x4xf32>, tensor<3x4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x4xf32>
  check.return
}

// A degenerate tile (mid_count 1) over more than one outer row: this is a plain
// copy, and it pins the outer axis. A kernel that ignored the outer index would
// write the first source row everywhere.
check.case public @ggml_repeat_f32_identity_case {
  %period = check.literal value(2) : index
  %mid_count = check.literal value(1) : index
  %outer_count = check.literal value(3) : index
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<3x2xf32>
  %output = check.generate.fill value(0.0) : tensor<3x2xf32>
  %expected = check.generate.iota offset(1.0) step(1.0) : tensor<3x2xf32>
  func.call @ggml_repeat_f32(%period, %mid_count, %outer_count, %input, %output) : (index, index, index, tensor<3x2xf32>, tensor<3x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x2xf32>
  check.return
}

// Rows wider than one workgroup, so the column loop's launch geometry is
// exercised rather than just its first tile.
check.case public @ggml_repeat_f32_wide_row_case {
  %period = check.literal value(300) : index
  %mid_count = check.literal value(2) : index
  %outer_count = check.literal value(1) : index
  %input = check.generate.fill value(7.0) : tensor<1x300xf32>
  %output = check.generate.fill value(0.0) : tensor<2x300xf32>
  %expected = check.generate.fill value(7.0) : tensor<2x300xf32>
  func.call @ggml_repeat_f32(%period, %mid_count, %outer_count, %input, %output) : (index, index, index, tensor<1x300xf32>, tensor<2x300xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<2x300xf32>
  check.return
}

check.benchmark<@ggml_repeat_f32_wide_row_case> @ggml_repeat_f32_wide_row
