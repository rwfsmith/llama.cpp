// SPDX-License-Identifier: Apache-2.0
//
// Affine scale (GGML_OP_SCALE), f32 -> f32: dst[i] = src[i] * scale + bias.
//
// HRX previously covered exactly one SCALE form -- the scale=0, bias=0 zero-fill
// that llama.cpp uses to clear a recurrent state slot (common.zero_f32) -- and
// left every other SCALE on the CPU. A GGML_SCHED_DEBUG=2 census of qwen4exp
// decode found 399 such nodes, and they are unusually expensive for their size
// because of where they land: SCALE is the single most common *first op* of a
// CPU split (146 occurrences). Several are lone nodes sitting inside an
// otherwise-contiguous HRX run, for example
//
//   SPLIT #1 HRX0  RMS_NORM, MUL, MUL_MAT
//   SPLIT #2 CPU   SCALE            <- one node
//   SPLIT #3 HRX0  SILU
//
// where covering the single node collapses three splits into one. A split
// boundary costs a queue submission plus staging of the crossing tensors, so a
// one-node CPU island is close to the worst thing in the graph per unit of work.
//
// scale and bias arrive as compile-time config rather than launch scalars
// because KernelSpecialization carries no f32 channel, the same way
// hrx_owned/l2_norm_f32.loom receives its epsilon.

amdgpu.target<gfx11-generic> @ggml_scale_gfx11_wave64 {subgroup_size = 64}

config.decl @ggml.scale_f32.scale : f32
config.decl @ggml.scale_f32.bias : f32

kernel.def target(@ggml_scale_gfx11_wave64) export("ggml_scale_f32") @ggml_scale_f32(
    %element_count: index) {
  %one = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %workgroup_size : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%element_count: index, %input: buffer, %output: buffer) {
  %scale = config.get @ggml.scale_f32.scale : f32
  %bias = config.get @ggml.scale_f32.bias : f32
  %count = index.assume %element_count [range(%element_count, 1, 268435456)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 256 : index
  %base = index.mul %workgroup, %workgroup_size : index
  %linear0 = index.add %base, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 268435455)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %zero_offset = index.constant 0 : offset
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %safe_index = index.assume %linear [lt(%linear, %count)] : index
    %value = view.load %input_view[%safe_index] : view<[%count]xf32> -> f32
    %scaled = scalar.mulf %value, %scale : f32
    %result = scalar.addf %scaled, %bias : f32
    view.store %result, %output_view[%safe_index] : f32, view<[%count]xf32>
  }
  kernel.return
}

// The corpus supplies both configs through the manifest's --config= test args.
// 3*x + 1 over an iota is exact in f32 and distinguishes a dropped bias, a
// dropped scale, and a swapped pair, all of which a scale-only case would miss.
check.case public @ggml_scale_f32_affine_case {
  %element_count = check.literal value(8) : index
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  %output = check.generate.fill value(0.0) : tensor<8xf32>
  %expected = check.generate.iota offset(1.0) step(3.0) : tensor<8xf32>
  func.call @ggml_scale_f32(%element_count, %input, %output) : (index, tensor<8xf32>, tensor<8xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<8xf32>
  check.return
}

// 1000 elements is not a multiple of the 256-wide workgroup, so the tail
// workgroup runs with most lanes masked off and must not write past the end.
check.case public @ggml_scale_f32_ragged_tail_case {
  %element_count = check.literal value(1000) : index
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<1000xf32>
  %output = check.generate.fill value(0.0) : tensor<1000xf32>
  %expected = check.generate.iota offset(1.0) step(3.0) : tensor<1000xf32>
  func.call @ggml_scale_f32(%element_count, %input, %output) : (index, tensor<1000xf32>, tensor<1000xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.001) rtol(0.000001) nan(same) : tensor<1000xf32>
  check.return
}

check.benchmark<@ggml_scale_f32_ragged_tail_case> @ggml_scale_f32_ragged_tail
