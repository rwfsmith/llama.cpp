// Standalone IQ4_NL routed-down (MoE ffn_down_exps) Loom kernel for the qwen4exp
// geometry: contraction/input = 640 (expert_hidden, 20 IQ4_NL blocks of 32),
// output = 2560 (hidden), route_count = 10, expert_count = 512.
//
// This is a NEW, self-contained file (does not modify the existing kernel
// corpus). It mirrors the proven Q8_0 "32-block routed_down" structural
// template (routed_down_q8_0.loom) described in hrx-moe-down-kernel-spec.md
// section 3: IQ4_NL is an 18-byte/32-element block (f16 d + 16 bytes of
// 4-bit codebook indices), so input=640 (640 % 32 == 0) contracts with the
// same simple one-subgroup-owns-one-output-channel reduction over 20 blocks
// used by Q8_0 -- no Q4_K 8-lane cohort / paired-group superblock schedule
// needed.
//
// Activation reuse: consumes the existing GGML block_q8_1_x4 physical layout
// (four 32-element Q8_1 blocks packed per 144-byte physical group) via the
// shared `ggml_q8_1_x4_block` accessor -- unchanged from the Q8_0/Q4_K/Q6_K
// kernels. Only the WEIGHT unpack + dot (signed s8s8, no min term) are new.
//
// The one hard part vs Q8_0: IQ4_NL weights are stored as 4-bit indices into
// a 16-entry signed-int8 codebook (KVALUES_IQ4NL), not whole bytes.
// Investigated approaches (in order tried, see qwen3_moe_iq4_nl_codebook_
// lookup below for the one that stuck):
//   1. `vector.table.lookup` (the genuine table op proven in the Loom corpus
//      test suite -- ops/vector/test/block_quant_samples.loom-test,
//      @iq_grid_reference_chunk) -- REJECTED by this AMDGPU target/shape
//      combo: "AMDGPU/023 ... rejected 'vector.table.lookup' ...
//      source-to-low constraint 'table_lookup.shape' is not satisfied".
//   2. An unrolled 16-way `vector.cmpi eq` / `vector.select` chain directly
//      on the packed vector<16xi8> nibble-index vectors -- REJECTED:
//      "AMDGPU/023 ... rejected 'vector.select' ... constraint
//      'select.packed_mask_uniform' is not satisfied" (AMDGPU only allows a
//      per-lane vector-mask select on "full width" register storage such as
//      i32; sub-word packed-payload storage like i8x16 only allows a
//      *uniform* (scalar-splat) select condition).
//   3. Widening each nibble-index vector to vector<16xi32> with
//      `vector.extui` and repeating the select chain at i32 granularity --
//      REJECTED: "TARGET/001 ... has no target-low contract for
//      'vector.extui' ..." (AMDGPU only lowers *narrowing* vector
//      conversions such as `vector.trunci`, not vector-shaped widening;
//      only the *scalar* forms `scalar.extui`/`scalar.extsi` have AMDGPU
//      contracts).
//   4. WORKS: extract each of the 16 nibble-index lanes to a scalar i8
//      (`vector.extract`), resolve it through a 15-step scalar
//      `scalar.cmpi eq` / `scf.select` chain (both proven scalar-i8 ops --
//      see tooling/target/spirv/test/spirv_vulkan_integer_hal_actual.loom
//      and ops/kernel/test/facts.loom-test:590), and reassemble the 16
//      scalar codebook results back into a vector<16xi8> with
//      `vector.from_elements`. This is exactly the "unrolled select-tree
//      over the 16 values" fallback the task allows, just done at scalar
//      (not vector-lane) granularity, which is what this AMDGPU target
//      contract actually supports for i8/i32 conversions and selects.

// Resolves one 4-bit codebook index (0..15) to its signed-int8 IQ4_NL
// weight value via a 15-step scalar compare/select chain. Widened to i32
// first: this AMDGPU target rejects `scalar.cmpi`/`scf.select` directly on
// i8 operands ("TARGET/002 ... rejected 'scalar.cmpi' field 'lhs' ...
// type i8 does not match i64" -- the target's i8 comparison rule doesn't
// exist here, only i32/i64 forms do), but `scalar.extui`/`scalar.trunci`
// between i8 and i32 DO have AMDGPU target-low contracts (unlike the
// *vector*-shaped widening conversions used in the earlier failed attempt
// -- AMDGPU only lowers *scalar* ext/trunc conversions, and only
// *narrowing* vector conversions). So the index is widened to i32, the
// chain runs entirely at i32, and the resolved codebook byte is narrowed
// back to i8 for the caller. Exactly one of the 15 `eq` comparisons is
// true when idx != 0, so the chain deterministically resolves to KV[idx]
// (and idx==0 falls through to the %kv0 base case untouched).
func.def inline @qwen3_moe_iq4_nl_codebook_lookup(%idx: i8) -> (i8) {
  %idx32 = scalar.extui %idx : i8 to i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %c9 = scalar.constant 9 : i32
  %c10 = scalar.constant 10 : i32
  %c11 = scalar.constant 11 : i32
  %c12 = scalar.constant 12 : i32
  %c13 = scalar.constant 13 : i32
  %c14 = scalar.constant 14 : i32
  %c15 = scalar.constant 15 : i32
  %kv0 = scalar.constant -127 : i32
  %kv1 = scalar.constant -104 : i32
  %kv2 = scalar.constant -83 : i32
  %kv3 = scalar.constant -65 : i32
  %kv4 = scalar.constant -49 : i32
  %kv5 = scalar.constant -35 : i32
  %kv6 = scalar.constant -22 : i32
  %kv7 = scalar.constant -10 : i32
  %kv8 = scalar.constant 1 : i32
  %kv9 = scalar.constant 13 : i32
  %kv10 = scalar.constant 25 : i32
  %kv11 = scalar.constant 38 : i32
  %kv12 = scalar.constant 53 : i32
  %kv13 = scalar.constant 69 : i32
  %kv14 = scalar.constant 89 : i32
  %kv15 = scalar.constant 113 : i32
  %m1 = scalar.cmpi eq, %idx32, %c1 : i32
  %a1 = scf.select %m1, %kv1, %kv0 : i32
  %m2 = scalar.cmpi eq, %idx32, %c2 : i32
  %a2 = scf.select %m2, %kv2, %a1 : i32
  %m3 = scalar.cmpi eq, %idx32, %c3 : i32
  %a3 = scf.select %m3, %kv3, %a2 : i32
  %m4 = scalar.cmpi eq, %idx32, %c4 : i32
  %a4 = scf.select %m4, %kv4, %a3 : i32
  %m5 = scalar.cmpi eq, %idx32, %c5 : i32
  %a5 = scf.select %m5, %kv5, %a4 : i32
  %m6 = scalar.cmpi eq, %idx32, %c6 : i32
  %a6 = scf.select %m6, %kv6, %a5 : i32
  %m7 = scalar.cmpi eq, %idx32, %c7 : i32
  %a7 = scf.select %m7, %kv7, %a6 : i32
  %m8 = scalar.cmpi eq, %idx32, %c8 : i32
  %a8 = scf.select %m8, %kv8, %a7 : i32
  %m9 = scalar.cmpi eq, %idx32, %c9 : i32
  %a9 = scf.select %m9, %kv9, %a8 : i32
  %m10 = scalar.cmpi eq, %idx32, %c10 : i32
  %a10 = scf.select %m10, %kv10, %a9 : i32
  %m11 = scalar.cmpi eq, %idx32, %c11 : i32
  %a11 = scf.select %m11, %kv11, %a10 : i32
  %m12 = scalar.cmpi eq, %idx32, %c12 : i32
  %a12 = scf.select %m12, %kv12, %a11 : i32
  %m13 = scalar.cmpi eq, %idx32, %c13 : i32
  %a13 = scf.select %m13, %kv13, %a12 : i32
  %m14 = scalar.cmpi eq, %idx32, %c14 : i32
  %a14 = scf.select %m14, %kv14, %a13 : i32
  %m15 = scalar.cmpi eq, %idx32, %c15 : i32
  %result32 = scf.select %m15, %kv15, %a14 : i32
  %result = scalar.trunci %result32 : i32 to i8
  func.return %result : i8
}

config.decl @qwen3_moe.routed_down_iq4_nl.input_size : %value: index where [range(%value, 32, 32768), mul(%value, 32)]

config.decl @qwen3_moe.routed_down_iq4_nl.route_count : %value: index where [range(%value, 1, 16)]

config.decl @qwen3_moe.routed_down_iq4_nl.expert_count : %value: index where [range(%value, 1, 512)]

config.decl @qwen3_moe.routed_down_iq4_nl.output_size : %value: index where [range(%value, 1, 4096)]

config.decl @qwen3_moe.workload_iq4_nl.token_capacity : %value: index where [range(%value, 1, 2048)]

// Defined (as `func.def inline`) in ggml/quantize_q8_1_x4.loom; re-declared
// here so this file can call it and loom-link resolves the definition from
// the linked library module, exactly as routed_down_q8_0.loom does.
func.decl @ggml_q8_1_x4_block(%q8_input: buffer, %row_byte_base: offset, %q8_block: index) -> (vector<32xi8>, f32, f32)

// Decodes one IQ4_NL weight block: 18 bytes = f16 d at offset 0, 16 bytes of
// packed 4-bit codebook indices at offset 2 (two indices per byte: low
// nibble = index for weight i, high nibble = index for weight i+16 -- the
// same low/high nibble-to-half-group convention qwen3_moe_q4k_chunk_global
// uses, verified against hrx_moe_oracle.py's dequant_iq4nl_block). Each of
// the 32 indices is resolved through the codebook (see
// qwen3_moe_iq4_nl_codebook_lookup above), producing two vector<16xi8>
// halves matching vector.dot4i's 16-lane operand width -- structurally
// identical to qwen3_moe_q8_0_chunk_global's two-halves return, but with a
// scalar codebook resolve standing in for Q8_0's direct signed-byte load.
func.def inline @qwen3_moe_iq4_nl_chunk_global(%weight: buffer, %row_byte_base: offset, %q4_block: index) -> (vector<16xi8>, vector<16xi8>, f32) {
  %block_bytes = index.constant 18 : offset
  %qs_byte_add = index.constant 2 : offset
  %c4_i32 = scalar.constant 4 : i32
  %nibble_mask = vector.constant 252645135 : vector<4xi32>
  %block_byte_add = index.scale %q4_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %qs_byte_base = index.add %block_byte_base, %qs_byte_add : offset
  %d_view = buffer.view %weight[%block_byte_base] : buffer -> view<1xf16>
  %qs_view = buffer.view %weight[%qs_byte_base] : buffer -> view<4xi32>
  %d_f16 = view.load %d_view[0] : view<1xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %qs_words = vector.load %qs_view[0] : view<4xi32> -> vector<4xi32>
  // Nibble split mirrors qwen3_moe_q4k_chunk_pair_global (routed_gate_up_swiglu
  // _q4k.loom ~L262-267): low nibble of each packed byte -> weight i (i<16),
  // high nibble -> weight i+16. (vector.bitfield.extractu on an i8-lane vector
  // is rejected by the AMDGPU target here -- amdgpu.arithmetic.vector_i32 --
  // so, like Q4_K, the nibble split is done as i32-lane andi/shrui+andi
  // before bitcasting down to i8 lanes.)
  %low_codes = vector.andi %qs_words, %nibble_mask : vector<4xi32>
  %c4_i32v = vector.splat %c4_i32 : vector<4xi32>
  %high_shifted = vector.shrui %qs_words, %c4_i32v : vector<4xi32>
  %high_codes = vector.andi %high_shifted, %nibble_mask : vector<4xi32>
  %idx_low8 = vector.bitcast %low_codes : vector<4xi32> to vector<16xi8>
  %idx_high8 = vector.bitcast %high_codes : vector<4xi32> to vector<16xi8>
  // Extract each nibble-index lane to a scalar and resolve it through the
  // codebook select chain (see the rationale comment above
  // qwen3_moe_iq4_nl_codebook_lookup for why this scalar path -- rather
  // than vector.table.lookup or a vector-lane select chain -- is what this
  // AMDGPU target actually compiles), then reassemble into vector<16xi8>.
  %idx_low_0 = vector.extract %idx_low8[0] : vector<16xi8> -> i8
  %idx_low_1 = vector.extract %idx_low8[1] : vector<16xi8> -> i8
  %idx_low_2 = vector.extract %idx_low8[2] : vector<16xi8> -> i8
  %idx_low_3 = vector.extract %idx_low8[3] : vector<16xi8> -> i8
  %idx_low_4 = vector.extract %idx_low8[4] : vector<16xi8> -> i8
  %idx_low_5 = vector.extract %idx_low8[5] : vector<16xi8> -> i8
  %idx_low_6 = vector.extract %idx_low8[6] : vector<16xi8> -> i8
  %idx_low_7 = vector.extract %idx_low8[7] : vector<16xi8> -> i8
  %idx_low_8 = vector.extract %idx_low8[8] : vector<16xi8> -> i8
  %idx_low_9 = vector.extract %idx_low8[9] : vector<16xi8> -> i8
  %idx_low_10 = vector.extract %idx_low8[10] : vector<16xi8> -> i8
  %idx_low_11 = vector.extract %idx_low8[11] : vector<16xi8> -> i8
  %idx_low_12 = vector.extract %idx_low8[12] : vector<16xi8> -> i8
  %idx_low_13 = vector.extract %idx_low8[13] : vector<16xi8> -> i8
  %idx_low_14 = vector.extract %idx_low8[14] : vector<16xi8> -> i8
  %idx_low_15 = vector.extract %idx_low8[15] : vector<16xi8> -> i8
  %idx_high_0 = vector.extract %idx_high8[0] : vector<16xi8> -> i8
  %idx_high_1 = vector.extract %idx_high8[1] : vector<16xi8> -> i8
  %idx_high_2 = vector.extract %idx_high8[2] : vector<16xi8> -> i8
  %idx_high_3 = vector.extract %idx_high8[3] : vector<16xi8> -> i8
  %idx_high_4 = vector.extract %idx_high8[4] : vector<16xi8> -> i8
  %idx_high_5 = vector.extract %idx_high8[5] : vector<16xi8> -> i8
  %idx_high_6 = vector.extract %idx_high8[6] : vector<16xi8> -> i8
  %idx_high_7 = vector.extract %idx_high8[7] : vector<16xi8> -> i8
  %idx_high_8 = vector.extract %idx_high8[8] : vector<16xi8> -> i8
  %idx_high_9 = vector.extract %idx_high8[9] : vector<16xi8> -> i8
  %idx_high_10 = vector.extract %idx_high8[10] : vector<16xi8> -> i8
  %idx_high_11 = vector.extract %idx_high8[11] : vector<16xi8> -> i8
  %idx_high_12 = vector.extract %idx_high8[12] : vector<16xi8> -> i8
  %idx_high_13 = vector.extract %idx_high8[13] : vector<16xi8> -> i8
  %idx_high_14 = vector.extract %idx_high8[14] : vector<16xi8> -> i8
  %idx_high_15 = vector.extract %idx_high8[15] : vector<16xi8> -> i8
  %w_low_0 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_0) : (i8) -> (i8)
  %w_low_1 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_1) : (i8) -> (i8)
  %w_low_2 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_2) : (i8) -> (i8)
  %w_low_3 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_3) : (i8) -> (i8)
  %w_low_4 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_4) : (i8) -> (i8)
  %w_low_5 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_5) : (i8) -> (i8)
  %w_low_6 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_6) : (i8) -> (i8)
  %w_low_7 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_7) : (i8) -> (i8)
  %w_low_8 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_8) : (i8) -> (i8)
  %w_low_9 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_9) : (i8) -> (i8)
  %w_low_10 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_10) : (i8) -> (i8)
  %w_low_11 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_11) : (i8) -> (i8)
  %w_low_12 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_12) : (i8) -> (i8)
  %w_low_13 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_13) : (i8) -> (i8)
  %w_low_14 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_14) : (i8) -> (i8)
  %w_low_15 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_low_15) : (i8) -> (i8)
  %w_high_0 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_0) : (i8) -> (i8)
  %w_high_1 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_1) : (i8) -> (i8)
  %w_high_2 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_2) : (i8) -> (i8)
  %w_high_3 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_3) : (i8) -> (i8)
  %w_high_4 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_4) : (i8) -> (i8)
  %w_high_5 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_5) : (i8) -> (i8)
  %w_high_6 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_6) : (i8) -> (i8)
  %w_high_7 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_7) : (i8) -> (i8)
  %w_high_8 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_8) : (i8) -> (i8)
  %w_high_9 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_9) : (i8) -> (i8)
  %w_high_10 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_10) : (i8) -> (i8)
  %w_high_11 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_11) : (i8) -> (i8)
  %w_high_12 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_12) : (i8) -> (i8)
  %w_high_13 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_13) : (i8) -> (i8)
  %w_high_14 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_14) : (i8) -> (i8)
  %w_high_15 = func.call @qwen3_moe_iq4_nl_codebook_lookup(%idx_high_15) : (i8) -> (i8)
  %w_low = vector.from_elements %w_low_0, %w_low_1, %w_low_2, %w_low_3, %w_low_4, %w_low_5, %w_low_6, %w_low_7, %w_low_8, %w_low_9, %w_low_10, %w_low_11, %w_low_12, %w_low_13, %w_low_14, %w_low_15 : vector<16xi8>
  %w_high = vector.from_elements %w_high_0, %w_high_1, %w_high_2, %w_high_3, %w_high_4, %w_high_5, %w_high_6, %w_high_7, %w_high_8, %w_high_9, %w_high_10, %w_high_11, %w_high_12, %w_high_13, %w_high_14, %w_high_15 : vector<16xi8>
  func.return %w_low, %w_high, %d : vector<16xi8>, vector<16xi8>, f32
}

// Contracts one signed 16-lane IQ4_NL (codebook-decoded) chunk against the
// matching signed Q8_1 activation half using AMDGPU's s8*s8 dot4
// instruction, scaled by d_a * d_w. No min-correction term: like Q8_0 (and
// unlike Q4_K/Q5_1), IQ4_NL has no per-block minimum -- the codebook is
// already zero-centered-ish and signed.
func.def inline @qwen3_moe_iq4_nl_q8_1_dot(%w_values: vector<16xi8>, %d: f32, %q8_values: vector<16xi8>, %q8_d: f32) -> (f32) {
  %c0_i32 = scalar.constant 0 : i32
  %c0_i32v = vector.constant 0 : vector<4xi32>
  %partial_dots = vector.dot4i<s8s8> %w_values, %q8_values, %c0_i32v : vector<16xi8>, vector<16xi8>, vector<4xi32>
  %q_sum = vector.reduce<addi> %partial_dots, %c0_i32 : vector<4xi32>, i32
  %q_sum_f32 = scalar.sitofp %q_sum : i32 to f32
  %scaled_d = scalar.mulf %q8_d, %d : f32
  %contribution = scalar.mulf %scaled_d, %q_sum_f32 : f32
  func.return %contribution : f32
}

// Shared IQ4_NL contraction and residual publication. One wave (subgroup)
// owns one output channel. Lanes 0..(block_count-1) each own one 32-weight
// IQ4_NL block (block_count=20 for input=640, well within one wave32); the
// wave subgroup-reduces once per route. Identical in structure to
// qwen3_moe_routed_down_q8_0_q8_1_x4_body -- only the per-block byte stride
// (18 vs 34) and the weight decode primitive differ.
func.template<qwen3_moe.routed_down_iq4_nl.q8_1_x4.body> device @qwen3_moe_routed_down_iq4_nl_q8_1_x4_body(%publish_output: i1, %token_count: index, %token: index, %input_size: index, %route_count: index, %route_id_stride: index, %expert_count: index, %output_size: index, %q8_input: buffer, %route_ids: buffer, %route_weights: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_token, %body_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
  %bounded_input_size = index.assume %input_size [range(%input_size, 32, 32768), mul(%input_size, 32)] : index
  %bounded_route_count = index.assume %route_count [range(%route_count, 1, 16)] : index
  %bounded_route_id_stride = index.assume %route_id_stride [range(%route_id_stride, 1, 512)] : index
  %bounded_expert_count = index.assume %expert_count [range(%expert_count, 1, 512)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c18 = index.constant 18 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %c1_byte = index.constant 1 : offset
  %c0_i32 = scalar.constant 0 : i32
  %c0_f32 = scalar.constant 0.0 : f32
  %c0_offset = index.constant 0 : offset
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %channel_base = index.mul %channel_tile, %c8 : index
  %channel = index.add %channel_base, %subgroup : index
  %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane_zero = scalar.cmpi eq, %lane_i32, %c0_i32 : i32
  %q4_block_count = index.div %bounded_input_size, %c32 : index
  %weight_row_byte_count = index.mul %q4_block_count, %c18 : index
  %q8_group_count = index.div %bounded_input_size, %c128 : index
  %q8_row_byte_count = index.mul %q8_group_count, %c144 : index
  %q8_noalias, %route_id_noalias, %route_weight_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %q8_input, %route_ids, %route_weights, %weight, %output : buffer, buffer, buffer, buffer, buffer
  %route_id_view = buffer.view %route_id_noalias[%c0_offset] : buffer -> view<[%body_token_count]x[%bounded_route_id_stride]xi32>
  %route_weight_view = buffer.view %route_weight_noalias[%c0_offset] : buffer -> view<[%body_token_count]x[%bounded_route_count]xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%body_token_count]x[%bounded_output_size]xf32>
  %computes_channel = scalar.andi %publish_output, %valid_channel : i1
  %routed_lane_sum = scf.if %computes_channel -> (f32) {
    %sum = scf.for %route = [%c0 to %bounded_route_count step %c1](%route_acc = %c0_f32 : f32) -> (f32) unroll {
      %route_for_weight, %route_bound_by_count = index.assume %route, %bounded_route_count [lt(%route, %bounded_route_count)] : index, index
      %route_for_id, %route_bound_by_stride = index.assume %route_for_weight, %bounded_route_id_stride [lt(%route_for_weight, %bounded_route_id_stride)] : index, index
      %expert_i32 = view.load %route_id_view[%bounded_token, %route_for_id] : view<[%body_token_count]x[%bounded_route_id_stride]xi32> -> i32
      %route_weight = view.load %route_weight_view[%bounded_token, %route_for_weight] : view<[%body_token_count]x[%bounded_route_count]xf32> -> f32
      %expert0 = index.cast %expert_i32 : i32 to index
      %expert1 = index.assume %expert0 [range(%expert0, 0, 511)] : index
      %expert, %weight_expert_count = index.assume %expert1, %bounded_expert_count [lt(%expert1, %bounded_expert_count)] : index, index
      %expert_output_base = index.mul %expert, %bounded_output_size : index
      %expert_channel = index.add %expert_output_base, %channel : index
      %weight_row_byte_index = index.mul %expert_channel, %weight_row_byte_count : index
      %weight_row_byte_base = index.scale %weight_row_byte_index, %c1_byte : index, offset -> offset
      %q8_row_base0 = index.mul %bounded_token, %bounded_route_count : index
      %q8_row = index.add %q8_row_base0, %route_for_weight : index
      %q8_row_byte_index = index.mul %q8_row, %q8_row_byte_count : index
      %q8_row_byte_base = index.scale %q8_row_byte_index, %c1_byte : index, offset -> offset
      %block_valid = index.cmp ult, %lane, %q4_block_count : index
      %lane_contrib = scf.if %block_valid -> (f32) {
        %block, %bounded_block_count = index.assume %lane, %q4_block_count [lt(%lane, %q4_block_count)] : index, index
        %w_low, %w_high, %d = func.call @qwen3_moe_iq4_nl_chunk_global(%weight_noalias, %weight_row_byte_base, %block) : (buffer, offset, index) -> (vector<16xi8>, vector<16xi8>, f32)
        %q8_values, %q8_d, %q8_s = func.call @ggml_q8_1_x4_block(%q8_noalias, %q8_row_byte_base, %block) : (buffer, offset, index) -> (vector<32xi8>, f32, f32)
        %q_low = vector.slice %q8_values[0] : vector<32xi8> -> vector<16xi8>
        %q_high = vector.slice %q8_values[16] : vector<32xi8> -> vector<16xi8>
        %contrib_low = func.call @qwen3_moe_iq4_nl_q8_1_dot(%w_low, %d, %q_low, %q8_d) : (vector<16xi8>, f32, vector<16xi8>, f32) -> (f32)
        %contrib_high = func.call @qwen3_moe_iq4_nl_q8_1_dot(%w_high, %d, %q_high, %q8_d) : (vector<16xi8>, f32, vector<16xi8>, f32) -> (f32)
        %contrib = scalar.addf<reassoc|nnan|ninf|nsz> %contrib_low, %contrib_high : f32
        scf.yield %contrib : f32
      } else {
        scf.yield %c0_f32 : f32
      }
      %weighted = scalar.mulf<reassoc|nnan|ninf|nsz> %lane_contrib, %route_weight : f32
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %route_acc, %weighted : f32
      scf.yield %next : f32
    }
    scf.yield %sum : f32
  } else {
    scf.yield %c0_f32 : f32
  }
  %routed_sum = kernel.subgroup.reduce<addf> %routed_lane_sum : f32
  %writes_active_channel = scalar.andi %publish_output, %valid_channel : i1
  %writes_output = scalar.andi %writes_active_channel, %is_lane_zero : i1
  scf.if %writes_output {
    %bounded_channel, %body_output_size = index.assume %channel, %bounded_output_size [lt(%channel, %bounded_output_size)] : index, index
    %residual = view.load %output_view[%bounded_token, %bounded_channel] : view<[%body_token_count]x[%bounded_output_size]xf32> -> f32
    %result = scalar.addf %residual, %routed_sum : f32
    view.store %result, %output_view[%bounded_token, %bounded_channel] : f32, view<[%body_token_count]x[%bounded_output_size]xf32>
  }
  func.return
}

kernel.def @qwen3_moe_routed_down_iq4_nl_q8_1_x4(%token_count: index, %input_size: index, %route_count: index, %route_id_stride: index, %expert_count: index, %output_size: index) {
  %token_capacity = config.get @qwen3_moe.workload_iq4_nl.token_capacity : index
  %configured_output_size = config.get @qwen3_moe.routed_down_iq4_nl.output_size : index
  %c8 = index.constant 8 : index
  %c7 = index.constant 7 : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %padded_output_size = index.add %configured_output_size, %c7 : index
  %output_tiles = index.div %padded_output_size, %c8 : index
  kernel.launch.config workgroups(%output_tiles, %token_capacity, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %route_count: index, %route_id_stride: index, %expert_count: index, %output_size: index, %q8_input: buffer, %route_ids: buffer, %route_weights: buffer, %weight: buffer, %output: buffer) {
  %token_capacity = config.get @qwen3_moe.workload_iq4_nl.token_capacity : index
  %configured_input_size0 = config.get @qwen3_moe.routed_down_iq4_nl.input_size : index
  %configured_route_count0 = config.get @qwen3_moe.routed_down_iq4_nl.route_count : index
  %configured_expert_count0 = config.get @qwen3_moe.routed_down_iq4_nl.expert_count : index
  %configured_output_size0 = config.get @qwen3_moe.routed_down_iq4_nl.output_size : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %bounded_input_size, %configured_input_size = index.assume %input_size, %configured_input_size0 [range(%input_size, 32, 32768), mul(%input_size, 32), eq(%input_size, %configured_input_size0)] : index, index
  %bounded_route_count, %configured_route_count = index.assume %route_count, %configured_route_count0 [range(%route_count, 1, 16), eq(%route_count, %configured_route_count0)] : index, index
  %bounded_route_id_stride = index.assume %route_id_stride [range(%route_id_stride, 1, 512)] : index
  %bounded_expert_count, %configured_expert_count = index.assume %expert_count, %configured_expert_count0 [range(%expert_count, 1, 512), eq(%expert_count, %configured_expert_count0)] : index, index
  %bounded_output_size, %configured_output_size = index.assume %output_size, %configured_output_size0 [range(%output_size, 1, 4096), eq(%output_size, %configured_output_size0)] : index, index
  %token0 = kernel.workgroup.id<y> : index
  %c0 = index.constant 0 : index
  %valid_token = index.cmp ult, %token0, %bounded_token_count : index
  %safe_token0 = scf.select %valid_token, %token0, %c0 : index
  %safe_token, %body_token_count = index.assume %safe_token0, %bounded_token_count [lt(%safe_token0, %bounded_token_count)] : index, index
  func.apply<qwen3_moe.routed_down_iq4_nl.q8_1_x4.body>(%valid_token, %body_token_count, %safe_token, %configured_input_size, %configured_route_count, %bounded_route_id_stride, %configured_expert_count, %configured_output_size, %q8_input, %route_ids, %route_weights, %weight, %output) : (i1, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

