// qwen4exp Hyper-Connections (HC) grouped RMSNorm, decode-only (single token).
//
// qwen4exp.cpp's build_ple()/grouped_norm() lambda reshapes the residual
// stream from [n_embd, n_tokens] to [n_embd, hc, n_tokens], applies RMS_NORM
// independently over each of the hc groups (each a full n_embd-wide row),
// reshapes to [hc*n_embd, n_tokens], multiplies elementwise by a weight of
// that SAME [hc*n_embd] width, then reshapes back to 3D. Element (e, h) of
// the weight is NOT broadcast across groups the way every other RMSNorm+MUL
// pattern in this codebase is -- group h uses its own private n_embd-wide
// weight slice at offset h*n_embd. This primitive is invoked three times per
// layer (ple_norm_key, ple_norm_query, ple_norm_conv) with identical shapes
// but distinct weight tensors.
//
// One workgroup owns one hc group. hc=4 (hparams.dsv4_hc_mult) and
// n_embd=2560 are fixed qwen4exp constants (verified from the GGUF and from
// the observed decode-time graph shape), so the launch geometry and buffer
// views below are fully compile-time shaped, matching every other qwen4exp
// decode-only kernel in this corpus.

// Every file that references this symbol must locally redeclare it -- loom-link
// validates each corpus source standalone (--mode=archive --strip-check) before
// the real archive link pulls in qwen4exp/model_config.loom's canonical decl.
config.decl @qwen4exp.model.rms_epsilon : f32

kernel.def export("qwen38_hc_grouped_norm_decode") @qwen38_hc_grouped_norm_decode() {
  %hc = index.constant 4 : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%hc, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  // rms_epsilon is a fixed model hyperparameter (qwen4exp.cpp: hparams.f_norm_rms_eps,
  // the same key shared with GDN's Q/K L2-norm and norm-gate RMSNorm), not a
  // per-dispatch value, so it is a compile-time config rather than a launch scalar.
  %rms_epsilon = config.get @qwen4exp.model.rms_epsilon : f32
  %group0 = kernel.workgroup.id<x> : index
  %group = index.assume %group0 [range(%group0, 0, 3)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %c256 = index.constant 256 : index
  %n_embd = index.constant 2560 : index
  %n_embd_f32 = scalar.constant 2560.0 : f32
  %c0_f32 = scalar.constant 0.0 : f32
  %c0_offset = index.constant 0 : offset
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<10240xf32>
  %weight_view = buffer.view %weight[%c0_offset] : buffer -> view<10240xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<10240xf32>
  %group_base = index.mul %group, %n_embd : index
  %thread_sum = scf.for %channel = [%lane to %n_embd step %c256](%running_sum = %c0_f32 : f32) -> (f32) {
    %element = index.add %group_base, %channel : index
    %value = view.load %input_view[%element] : view<10240xf32> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %running_sum, %square : f32
    scf.yield %next_sum : f32
  }
  %sum = kernel.workgroup.reduce<addf> %thread_sum : f32
  %mean = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %sum, %n_embd_f32 : f32
  %biased_mean = scalar.addf<reassoc|nnan|ninf|nsz> %mean, %rms_epsilon : f32
  %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
  scf.for %channel = [%lane to %n_embd step %c256] {
    %element = index.add %group_base, %channel : index
    %value = view.load %input_view[%element] : view<10240xf32> -> f32
    %learned_weight = view.load %weight_view[%element] : view<10240xf32> -> f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %inverse_rms : f32
    %result = scalar.mulf<reassoc|nnan|ninf|nsz> %normalized, %learned_weight : f32
    view.store %result, %output_view[%element] : f32, view<10240xf32>
  }
  kernel.return
}

// Production-shape timing boundary, mirrored on the GDN norm-gate benchmark below it.
check.case public @qwen38_hc_grouped_norm_decode_benchmark_case {
  %input = check.generate.fill value(0.125) : tensor<10240xf32>
  %weight = check.generate.fill value(1.0) : tensor<10240xf32>
  %output = check.generate.fill value(0.0) : tensor<10240xf32>
  kernel.launch @qwen38_hc_grouped_norm_decode(%input, %weight, %output) : (tensor<10240xf32>, tensor<10240xf32>, tensor<10240xf32>)
  check.return
}

check.case public @qwen38_hc_grouped_norm_decode_known_case {
  %input = check.generate.fill value(0.125) : tensor<10240xf32>
  %weight = check.generate.iota offset(-1.0) step(0.000244140625) : tensor<10240xf32>
  %output = check.generate.fill value(0.0) : tensor<10240xf32>
  // input is uniform, so every one of the 4 groups independently normalizes to the
  // SAME per-element constant c = x*rsqrt(x^2+eps) (all f32 arithmetic): x=0.125,
  // eps=0.000001 -> c=0.9999679923057556. weight is a single linear ramp across all
  // 10240 elements (spanning all 4 groups distinctly, not repeating per-group), so
  // expected[i] = c*weight[i] is exactly reproducible as another iota with
  // offset/step scaled by c. This precisely exercises the per-group weight indexing
  // (a wrong group_base or group/element mixup would misalign this ramp and fail
  // the comparison, even though a uniform-weight test could not tell the difference).
  %expected = check.generate.iota offset(-0.9999679923057556) step(0.00024413281062152237) : tensor<10240xf32>
  kernel.launch @qwen38_hc_grouped_norm_decode(%input, %weight, %output) : (tensor<10240xf32>, tensor<10240xf32>, tensor<10240xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<10240xf32>
  check.return
}

check.benchmark<@qwen38_hc_grouped_norm_decode_benchmark_case> @qwen38_hc_grouped_norm_decode_latency
